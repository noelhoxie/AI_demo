{
  "datasets": [
    {
      "displayName": "OEE by Machine Center",
      "name": "oee_by_machine",
      "query": "SELECT facility, machine_center, production_date, availability, performance, quality, oee, planned_time_minutes, run_time_minutes, downtime_minutes, good_count, scrap_count, total_count FROM qad_gold_oee_by_machine_center ORDER BY production_date DESC, facility, machine_center"
    },
    {
      "displayName": "OEE Latest",
      "name": "oee_latest",
      "query": "SELECT facility, machine_center, production_date, ROUND(availability * 100, 1) AS availability_pct, ROUND(performance * 100, 1) AS performance_pct, ROUND(quality * 100, 1) AS quality_pct, ROUND(oee * 100, 1) AS oee_pct FROM qad_gold_oee_latest ORDER BY facility, machine_center"
    }
  ],
  "pages": [
    {
      "displayName": "QAD OEE",
      "layout": [
        {
          "position": { "height": 1, "width": 6, "x": 0, "y": 0 },
          "widget": { "name": "title", "textbox_spec": "# QAD OEE — Gold tables (5 machine centers, 3 facilities)" }
        },
        {
          "position": { "height": 2, "width": 2, "x": 0, "y": 1 },
          "widget": {
            "name": "avg_oee",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "oee_latest",
                  "disaggregated": false,
                  "fields": [{ "expression": "AVG(`oee_pct`)", "name": "avg_oee_pct" }]
                }
              }
            ],
            "spec": {
              "encodings": { "value": { "displayName": "Avg OEE %", "fieldName": "avg_oee_pct" } },
              "frame": { "showTitle": true, "title": "Average OEE %" },
              "version": 2,
              "widgetType": "counter"
            }
          }
        },
        {
          "position": { "height": 6, "width": 6, "x": 0, "y": 3 },
          "widget": {
            "name": "oee_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "oee_latest",
                  "disaggregated": true,
                  "fields": [
                    { "expression": "`facility`", "name": "facility" },
                    { "expression": "`machine_center`", "name": "machine_center" },
                    { "expression": "`oee_pct`", "name": "oee_pct" },
                    { "expression": "`availability_pct`", "name": "availability_pct" },
                    { "expression": "`performance_pct`", "name": "performance_pct" },
                    { "expression": "`quality_pct`", "name": "quality_pct" }
                  ]
                }
              }
            ],
            "spec": {
              "encodings": {
                "columns": [
                  { "displayName": "Facility", "fieldName": "facility" },
                  { "displayName": "Machine Center", "fieldName": "machine_center" },
                  { "displayName": "OEE %", "fieldName": "oee_pct" },
                  { "displayName": "Availability %", "fieldName": "availability_pct" },
                  { "displayName": "Performance %", "fieldName": "performance_pct" },
                  { "displayName": "Quality %", "fieldName": "quality_pct" }
                ]
              },
              "frame": { "showTitle": true, "title": "Latest OEE by Machine Center (qad_gold_oee_latest)" },
              "version": 2,
              "widgetType": "table"
            }
          }
        },
        {
          "position": { "height": 5, "width": 6, "x": 0, "y": 9 },
          "widget": {
            "name": "oee_bar",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "oee_latest",
                  "disaggregated": true,
                  "fields": [
                    { "expression": "CONCAT(`facility`, ' — ', `machine_center`)", "name": "facility_machine" },
                    { "expression": "`oee_pct`", "name": "oee_pct" }
                  ]
                }
              }
            ],
            "spec": {
              "encodings": {
                "x": {
                  "displayName": "Facility — Machine",
                  "fieldName": "facility_machine",
                  "scale": { "type": "categorical" }
                },
                "y": {
                  "displayName": "OEE %",
                  "fieldName": "oee_pct",
                  "scale": { "type": "quantitative" }
                }
              },
              "frame": { "showTitle": true, "title": "OEE % by Machine Center" },
              "version": 3,
              "widgetType": "bar"
            }
          }
        }
      ]
    }
  ]
}
